# apps/web configuration. Copy to .env.local for local dev (git-ignored).

# Auth.js cookie encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-random-bytes
AUTH_URL=http://localhost:3000

# Where apps/api lives. apps/web calls it server-side only.
API_BASE_URL=http://localhost:3001

# ── Dev bypass ────────────────────────────────────────────────────────────
# Mints tokens with a LOCAL key and serves its own JWKS at /api/dev-jwks.
# apps/api validates them with its real jose code path — this swaps the token
# ISSUER, it does not skip authentication.
#
# Setting this with NODE_ENV=production makes each of THREE entry points
# REFUSE TO BOOT / SERVE (case-insensitively — "Production" trips it too):
# auth.ts, middleware.ts (via auth.config.ts), and the /api/dev-jwks route.
# That is three separate calls to assertBypassNotInProduction, not one gate
# covering all three automatically — a whole-branch review found the
# dev-jwks route had neither guard, because it imports lib/dev-identity
# directly and never pulled in auth.config.ts by any other path. The rule:
# any module that imports lib/dev-identity directly must call
# assertBypassNotInProduction(process.env) itself at module scope.
AUTH_DEV_BYPASS=true

# Audience claim on the token the dev provider mints. Must match what
# apps/api expects. Defaults to api://irp-progress-management when unset.
API_SCOPE_AUDIENCE=api://irp-progress-management

# ── Microsoft Entra (unused while the bypass is on) ───────────────────────
#
# Leave all three EMPTY until you have a real tenant. The Entra provider is
# registered only when all three are non-empty (see isEntraConfigured in
# auth.config.ts), because registering it with an empty issuer makes Auth.js
# throw InvalidEndpoints on EVERY auth request — taking the dev bypass down
# with it.
#
# A previous version of this file shipped a NON-EMPTY placeholder issuer
# (`.../<tenant-id>/v2.0`). That looked harmless and was worse than empty: it
# satisfied the old unconditional registration locally with a bogus value, so
# the bug only appeared in CI, where no .env.local exists. Do not put a
# placeholder in a variable whose emptiness is load-bearing.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
API_SCOPE=api://irp-progress-management/access_as_user
